# Runtime state the anchor and the grant ledger write next to the checkout when
# no explicit path is given -- a test run from the repo root is enough to
# create it. The secret key inside is already covered by *.key.json above; this
# keeps the rest (a CRLF-carrying ledger, which fails the encoding gate) out of
# the tree as well.
data/
*.tmp

# Node / TS
node_modules/
sdk/typescript/dist/
pwa/dist/
pwa/.next/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated / secret-bearing runtime artifacts (never commit)
issuer*.json
*.key.json
*.controller.sealed.json
anchor.env
master_secrets.json

# Local-only artifacts (not for public repo)
README_old.md
eopx_format_spec.docx
eopx_verify_spec.docx
DOCUMENT DE SYNTHÈSE*.txt
DOCUMENT DE SYNTH*RECHERCHE*.txt

